# Data directories (raw, interim, external - never commit sensitive/heavy data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/samples/*
!data/samples/sample_churn_input.csv

# Model storage and local checkpoint weights
models/saved/*
!models/saved/.gitkeep
*.pkl
*.joblib
*.h5
*.onnx

# Reports and generated drift summaries
reports/drift/*
!reports/drift/.gitkeep
reports/evaluations/*
!reports/evaluations/.gitkeep
!reports/evaluations/training_report.md
!reports/evaluations/training_metrics.json
!reports/evaluations/shap_importances.json
!reports/evaluations/mlflow_migration_audit.json
!reports/evaluations/synthetic/
!reports/evaluations/synthetic/*
reports/figures/*
!reports/figures/.gitkeep

