      "title": "Delayed Ground Truth Ingested",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(monitoring_ground_truth_feedback_total) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "title": "Feature Drift Share History",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "monitoring_drift_share",
          "legendFormat": "Drift Share",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "title": "Retraining Recommendations Emitted",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(monitoring_retraining_recommendations_total) by (priority, trigger_reason)",
          "legendFormat": "{{priority}} ({{trigger_reason}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 25, "lineWidth": 2 },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "title": "Verified Ground-Truth Performance (Supervised Holdout)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "monitoring_model_roc_auc > 0",
          "legendFormat": "ROC-AUC",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "monitoring_model_pr_auc > 0",
          "legendFormat": "PR-AUC",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "monitoring_model_f1 > 0",
          "legendFormat": "F1 Score",
          "refId": "C"
        },
        {
          "datasource": "Prometheus",
          "expr": "monitoring_model_brier_score > 0",
          "legendFormat": "Brier Score",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "max": 1,
          "min": 0,
          "unit": "short"
        }
      }
    }
