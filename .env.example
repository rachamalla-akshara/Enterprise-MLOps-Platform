# ==============================================================================
# Enterprise MLOps Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the values for your local or cloud setup.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
PROJECT_NAME="Enterprise MLOps Platform"
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                          # Strictly 1: In-memory model state requires 1 worker per container for reload consistency
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
API_KEY_HEADER_NAME=X-API-Key
SERVING_API_KEY=dev-secret-api-key-replace-in-prod

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration (Metadata & Prediction Logging)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlops_db
POSTGRES_USER=mlops_user
POSTGRES_PASSWORD=mlops_password
POSTGRES_SCHEMA=public
# Full SQLAlchemy Connection URL:
DATABASE_URL=postgresql://mlops_user:mlops_password@postgres:5432/mlops_db

# ------------------------------------------------------------------------------
# 3. MLflow Tracking & Model Registry Configuration
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow-server:5000
MLFLOW_EXPERIMENT_NAME=customer-churn-prediction
MLFLOW_REGISTERED_MODEL_NAME=customer-churn-classifier
MLFLOW_TRACKING_USERNAME=mlflow_admin
MLFLOW_TRACKING_PASSWORD=mlflow_secret_password

# ------------------------------------------------------------------------------
# 4. S3 / MinIO Object Storage (MLflow Artifacts & Dataset Storage)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_S3_IGNORE_TLS=true
S3_BUCKET_NAME=mlops-artifacts

# ------------------------------------------------------------------------------
# 5. Model Serving & Deployment Configuration
# ------------------------------------------------------------------------------
# Model loader target: 'registry' (loads active Production/Champion alias) or 'local'
MODEL_SOURCE=registry
ACTIVE_MODEL_ALIAS=champion
SERVING_MODEL_ALIAS=champion
SERVING_RELOAD_TOKEN=dev-admin-secret-key-phase3
SERVING_DECISION_THRESHOLD=0.571
PREDICTION_DB_URI=postgresql://mlops_user:mlops_password@postgres:5432/mlops_db
LOCAL_MODEL_PATH=models/saved/best_model_pipeline.joblib
INFERENCE_BATCH_MAX_SIZE=1000

# ------------------------------------------------------------------------------
# 6. Evidently AI & Data Drift Monitoring Configuration
# ------------------------------------------------------------------------------
DRIFT_DETECTION_INTERVAL_HOURS=24
DRIFT_THRESHOLD_SHARE=0.30               # Trigger alert/retraining if >30% features drifted
P_VALUE_THRESHOLD=0.05                  # Statistical significance threshold
REFERENCE_DATA_PATH=data/processed/reference_dataset.parquet
PREDICTIONS_WINDOW_DAYS=7
EVIDENTLY_REPORT_DIR=reports/drift

# ------------------------------------------------------------------------------
# 7. Automated Retraining Pipeline Trigger
# ------------------------------------------------------------------------------
AUTO_RETRAIN_ENABLED=true
RETRAINING_WEBHOOK_URL=http://api:8000/api/v1/pipeline/retrain
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/WEBHOOK

# ------------------------------------------------------------------------------
# 8. Prometheus & Observability Configuration
# ------------------------------------------------------------------------------
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_PORT=8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password

# ------------------------------------------------------------------------------
# 9. Frontend Application (React Dashboard)
# ------------------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
PORT=3000
